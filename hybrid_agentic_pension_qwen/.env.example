# auto: API key가 있으면 Qwen Agent, 없으면 demo fallback
APP_MODE=auto

# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=

# 가장 간단한 Beijing shared endpoint (기존 도메인, 계속 사용 가능)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Function Calling 지원 모델. 필요하면 콘솔에서 사용 가능한 모델로 변경
QWEN_MODEL=qwen3.6-plus

# RAG semantic embedding (선택: build_semantic_index.py 실행 시 사용)
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIM=1024
