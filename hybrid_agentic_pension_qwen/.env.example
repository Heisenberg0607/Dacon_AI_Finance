# auto: API key가 있으면 Qwen Agent, 없으면 demo fallback
APP_MODE=auto

# Alibaba Cloud Model Studio / DashScope
DASHSCOPE_API_KEY=

# 가장 간단한 Beijing shared endpoint
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Function Calling 지원 모델
QWEN_MODEL=qwen3.6-plus

# RAG semantic embedding
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIM=1024

# ------------------------------------------------------------
# Salary Growth Model API
# CatBoost는 Vercel에서 직접 설치/실행하지 않고 외부 모델 서버에서 실행.
# 예: https://your-salary-model-api.example.com
# 끝에 / 는 없어도 됨.
# ------------------------------------------------------------
SALARY_GROWTH_API_URL=
SALARY_GROWTH_API_KEY=
SALARY_GROWTH_API_TIMEOUT_SECONDS=20
